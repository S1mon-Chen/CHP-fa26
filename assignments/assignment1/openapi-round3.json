{"openapi":"3.0.3","info":{"title":"E-BookStore 图书管理后台 API","version":"1.0.0","description":"E-BookStore 图书管理后台接口契约（Spring Boot 3 + JPA），统一前缀 /api，本期仅涉及图书资源，无需鉴权。\nASSUMPTIONS: 1) ISBN-13 以 13 位纯数字传输（不含连字符），以 978 或 979 开头，并在服务端校验唯一性；2) 需求中分页结构的 content: Book[] 采用 BookResponse 作为元素类型；3) LocalDateTime 字段按 ISO-8601 date-time 字符串序列化（示例统一使用 UTC 格式）；4) description 与 coverImage 为可选字段，响应中未设置时返回 null，需求未给出长度上限，因此不额外限制长度；5) coverImage 须为合法 URI；6) price 未给出上限，仅约束 ≥0 且最多两位小数（由服务端 @Digits(fraction = 2) 校验）；7) stock 与 delta 使用 int32；delta 为 0、缺失或非整数时返回 400；8) 列表接口不提供排序参数，返回顺序由服务端决定；9) 新增 category 字段对创建请求与图书响应均为必填；10) POST 201 响应的 Location 头返回新资源的绝对 URL；11) 400 错误码使用 VALIDATION_FAILED，404 使用 BOOK_NOT_FOUND，ISBN 冲突使用 ISBN_ALREADY_EXISTS，库存不足使用 INSUFFICIENT_STOCK，500 使用 INTERNAL_ERROR。"},"servers":[{"url":"http://localhost:8080","description":"本地开发环境"}],"tags":[{"name":"Books","description":"图书管理"}],"paths":{"/api/books":{"get":{"tags":["Books"],"summary":"获取书目列表","description":"分页查询图书列表，可按分类筛选。页码从 0 开始。","operationId":"listBooks","security":[],"parameters":[{"name":"page","in":"query","required":false,"description":"页码，从 0 开始","schema":{"type":"integer","format":"int32","minimum":0,"default":0},"example":0},{"name":"size","in":"query","required":false,"description":"每页条数，范围 1–100","schema":{"type":"integer","format":"int32","minimum":1,"maximum":100,"default":10},"example":10},{"name":"category","in":"query","required":false,"description":"图书分类，不传则不按分类筛选","schema":{"type":"string","enum":["LITERATURE","SCIENCE","TECHNOLOGY","HISTORY","ART","CHILDREN","OTHER"]},"example":"TECHNOLOGY"}],"responses":{"200":{"description":"查询成功","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PageBookResponse"}}}},"400":{"description":"查询参数非法（错误码 VALIDATION_FAILED）","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"服务器内部错误（错误码 INTERNAL_ERROR）","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"post":{"tags":["Books"],"summary":"添加新书","description":"创建一本新书。id、createdAt、updatedAt 由服务端生成。创建成功后在响应头 Location 中返回新资源地址。","operationId":"createBook","security":[],"requestBody":{"required":true,"description":"新书信息","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookCreateRequest"}}}},"responses":{"201":{"description":"创建成功","headers":{"Location":{"description":"新建图书资源的 URL","required":true,"schema":{"type":"string","format":"uri"},"example":"http://localhost:8080/api/books/1"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookResponse"}}}},"400":{"description":"请求体校验失败（错误码 VALIDATION_FAILED，可包含 errors 字段明细）","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"ISBN 已存在（错误码 ISBN_ALREADY_EXISTS）","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"服务器内部错误（错误码 INTERNAL_ERROR）","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/books/{id}":{"get":{"tags":["Books"],"summary":"查看单本书详情","description":"根据图书 ID 返回图书完整信息。","operationId":"getBookById","security":[],"parameters":[{"name":"id","in":"path","required":true,"description":"图书 ID","schema":{"type":"integer","format":"int64","minimum":1},"example":1}],"responses":{"200":{"description":"查询成功","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookResponse"}}}},"400":{"description":"路径参数非法（错误码 VALIDATION_FAILED）","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"图书不存在（错误码 BOOK_NOT_FOUND）","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"服务器内部错误（错误码 INTERNAL_ERROR）","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/books/{id}/stock":{"patch":{"tags":["Books"],"summary":"更新库存","description":"按增量调整图书库存：delta 为正数表示入库，为负数表示出库，不允许为 0。若调整后库存小于 0，则返回 409 且库存不变。成功时返回更新后的完整图书信息。","operationId":"updateBookStock","security":[],"parameters":[{"name":"id","in":"path","required":true,"description":"图书 ID","schema":{"type":"integer","format":"int64","minimum":1},"example":1}],"requestBody":{"required":true,"description":"库存增量","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StockUpdateRequest"}}}},"responses":{"200":{"description":"库存更新成功，返回更新后的图书","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookResponse"}}}},"400":{"description":"请求参数校验失败，例如 delta 缺失或为 0（错误码 VALIDATION_FAILED）","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"图书不存在（错误码 BOOK_NOT_FOUND）","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"调整后库存将小于 0（错误码 INSUFFICIENT_STOCK）","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"服务器内部错误（错误码 INTERNAL_ERROR）","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}}},"components":{"schemas":{"BookResponse":{"type":"object","description":"图书完整信息","required":["id","title","author","isbn","price","stock","category","createdAt","updatedAt"],"properties":{"id":{"type":"integer","format":"int64","description":"主键，自增","minimum":1,"example":1},"title":{"type":"string","description":"书名，不超过 200 个字符","minLength":1,"maxLength":200,"example":"深入理解 Java 虚拟机"},"author":{"type":"string","description":"作者，不超过 100 个字符","minLength":1,"maxLength":100,"example":"周志明"},"isbn":{"type":"string","description":"ISBN-13，13 位数字，全局唯一","pattern":"^97[89][0-9]{10}$","example":"9787111641247"},"description":{"type":"string","description":"简介，可选","nullable":true,"example":"系统讲解 JVM 内存管理、类加载与执行引擎。"},"price":{"type":"number","description":"价格（BigDecimal），≥0，最多两位小数","minimum":0,"example":129.00},"stock":{"type":"integer","format":"int32","description":"库存，≥0","minimum":0,"example":50},"coverImage":{"type":"string","format":"uri","description":"封面图片 URL，可选","nullable":true,"example":"https://cdn.example.com/covers/9787111641247.jpg"},"category":{"type":"string","description":"图书分类","enum":["LITERATURE","SCIENCE","TECHNOLOGY","HISTORY","ART","CHILDREN","OTHER"],"example":"TECHNOLOGY"},"createdAt":{"type":"string","format":"date-time","description":"创建时间，由服务端生成","example":"2026-10-01T10:15:30Z"},"updatedAt":{"type":"string","format":"date-time","description":"更新时间，由服务端生成","example":"2026-10-01T10:15:30Z"}}},"BookCreateRequest":{"type":"object","description":"添加新书请求体，不包含 id、createdAt、updatedAt","required":["title","author","isbn","price","stock","category"],"properties":{"title":{"type":"string","description":"书名，必填，不超过 200 个字符","minLength":1,"maxLength":200,"example":"深入理解 Java 虚拟机"},"author":{"type":"string","description":"作者，必填，不超过 100 个字符","minLength":1,"maxLength":100,"example":"周志明"},"isbn":{"type":"string","description":"ISBN-13，必填，13 位数字，必须唯一","pattern":"^97[89][0-9]{10}$","example":"9787111641247"},"description":{"type":"string","description":"简介，可选","nullable":true,"example":"系统讲解 JVM 内存管理、类加载与执行引擎。"},"price":{"type":"number","description":"价格（BigDecimal），必填，≥0，最多两位小数","minimum":0,"example":129.00},"stock":{"type":"integer","format":"int32","description":"初始库存，必填，≥0","minimum":0,"example":50},"coverImage":{"type":"string","format":"uri","description":"封面图片 URL，可选","nullable":true,"example":"https://cdn.example.com/covers/9787111641247.jpg"},"category":{"type":"string","description":"图书分类，必填","enum":["LITERATURE","SCIENCE","TECHNOLOGY","HISTORY","ART","CHILDREN","OTHER"],"example":"TECHNOLOGY"}}},"StockUpdateRequest":{"type":"object","description":"库存增量更新请求体","required":["delta"],"properties":{"delta":{"type":"integer","format":"int32","description":"库存增量，不能为 0；正数表示入库，负数表示出库","not":{"enum":[0]},"example":-2}}},"PageBookResponse":{"type":"object","description":"图书分页结果","required":["content","page","size","totalElements","totalPages"],"properties":{"content":{"type":"array","description":"当前页图书列表","items":{"$ref":"#/components/schemas/BookResponse"}},"page":{"type":"integer","format":"int32","description":"当前页码，从 0 开始","minimum":0,"example":0},"size":{"type":"integer","format":"int32","description":"每页条数","minimum":1,"maximum":100,"example":10},"totalElements":{"type":"integer","format":"int64","description":"总记录数","minimum":0,"example":42},"totalPages":{"type":"integer","format":"int32","description":"总页数","minimum":0,"example":5}}},"FieldError":{"type":"object","description":"字段级校验错误明细","required":["field","message"],"properties":{"field":{"type":"string","description":"校验失败的字段名","example":"isbn"},"message":{"type":"string","description":"该字段的错误信息","example":"ISBN 必须为以 978 或 979 开头的 13 位数字"}}},"ErrorResponse":{"type":"object","description":"统一错误响应结构","required":["code","message","status","path","timestamp"],"properties":{"code":{"type":"string","description":"机器可读错误码，如 VALIDATION_FAILED、BOOK_NOT_FOUND、ISBN_ALREADY_EXISTS、INSUFFICIENT_STOCK、INTERNAL_ERROR","example":"BOOK_NOT_FOUND"},"message":{"type":"string","description":"人类可读错误信息","example":"ID 为 999 的图书不存在"},"status":{"type":"integer","format":"int32","description":"HTTP 状态码","minimum":400,"maximum":599,"example":404},"path":{"type":"string","description":"请求路径","example":"/api/books/999"},"timestamp":{"type":"string","format":"date-time","description":"错误发生时间","example":"2026-10-01T10:15:30Z"},"errors":{"type":"array","description":"字段级校验错误明细，仅在 400 校验失败时出现","items":{"$ref":"#/components/schemas/FieldError"}}}}}}}
