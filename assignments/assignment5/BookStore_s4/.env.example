# Copy to .env; sourced by scripts/run-assignment3.sh. Never commit .env.
# Base URL includes /v1 where required; do not append /chat/completions.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90
EMBEDDING_URL=http://127.0.0.1:8092/embed

# Assignment 4: optional fixed Base64 secret (at least 32 random bytes).
# Empty: launch scripts create a temporary secret. Never commit a real signing key.
JWT_SECRET=

# Optional existing MySQL configuration; the demo profiles use isolated H2 instead.
DB_USERNAME=root
DB_PASSWORD=
