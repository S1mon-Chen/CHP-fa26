<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.16</version><relativePath/></parent>
  <groupId>com.bookstore</groupId><artifactId>assignment4-integrated</artifactId><version>1.0.0</version>
  <properties><java.version>21</java.version><jjwt.version>0.13.0</jjwt.version></properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-api</artifactId><version>${jjwt.version}</version></dependency>
    <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-impl</artifactId><version>${jjwt.version}</version><scope>runtime</scope></dependency>
    <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-jackson</artifactId><version>${jjwt.version}</version><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <!-- Compile the very same integrated sources, without copying or maintaining a second API. -->
    <sourceDirectory>../backend/src/main/java</sourceDirectory>
    <testSourceDirectory>../backend/src/test/java</testSourceDirectory>
    <resources>
      <resource><directory>../backend/src/main/resources</directory><includes>
        <include>application-jwt.properties</include><include>application-demo.properties</include>
        <include>application-assignment4.properties</include><include>data-demo.sql</include>
        <include>static/verify.html</include>
      </includes></resource>
      <resource><directory>src/main/resources</directory></resource>
    </resources>
    <testResources><testResource><directory>../backend/src/test/resources</directory><includes>
      <include>application-test.properties</include>
    </includes></testResource></testResources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><configuration>
        <includes>
            <include>com/bookstore/BookStoreApplication.java</include>
            <include>com/bookstore/config/SecurityConfig.java</include>
            <include>com/bookstore/config/Assignment4DemoData.java</include>
            <include>com/bookstore/controller/BookController.java</include>
            <include>com/bookstore/controller/UserController.java</include>
            <include>com/bookstore/dto/BookResponseDTO.java</include>
            <include>com/bookstore/dto/LoginRequestDTO.java</include>
            <include>com/bookstore/dto/LoginResponseDTO.java</include>
            <include>com/bookstore/dto/RegisterRequestDTO.java</include>
            <include>com/bookstore/dto/UserBanRequestDTO.java</include>
            <include>com/bookstore/dto/UserResponseDTO.java</include>
            <include>com/bookstore/entity/Book.java</include>
            <include>com/bookstore/entity/User.java</include>
            <include>com/bookstore/exception/GlobalExceptionHandler.java</include>
            <include>com/bookstore/repository/BookRepository.java</include>
            <include>com/bookstore/repository/UserRepository.java</include>
            <include>com/bookstore/security/JwtService.java</include>
            <include>com/bookstore/security/JwtAuthenticationEntryPoint.java</include>
            <include>com/bookstore/security/JwtAuthenticationFilter.java</include>
            <include>com/bookstore/service/BookService.java</include>
            <include>com/bookstore/service/CurrentUser.java</include>
            <include>com/bookstore/service/UserService.java</include>
            <include>com/bookstore/service/UserDetailsServiceImpl.java</include>
            <include>com/bookstore/utils/BookCoverGenerator.java</include>
        </includes>
        <testIncludes><testInclude>com/bookstore/security/BookstoreJwtHttpTest.java</testInclude></testIncludes>
      </configuration></plugin>
      <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
    </plugins>
  </build>
</project>
