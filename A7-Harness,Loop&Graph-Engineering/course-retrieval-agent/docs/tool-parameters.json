[
  {
    "name": "list_documents",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "topic": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic"
        },
        "limit": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "ListArgs",
      "type": "object"
    }
  },
  {
    "name": "search_documents",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "document_ids": {
          "anyOf": [
            {
              "items": {
                "pattern": "^doc_[0-9a-f]{16}$",
                "type": "string"
              },
              "maxItems": 20,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Ids"
        },
        "top_k": {
          "default": 3,
          "maximum": 5,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "title": "SearchArgs",
      "type": "object"
    }
  },
  {
    "name": "read_document",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "pattern": "^doc_[0-9a-f]{16}$",
          "title": "Document Id",
          "type": "string"
        },
        "chunk_ids": {
          "items": {
            "pattern": "^chunk_[0-9a-f]{24}$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Chunk Ids",
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "chunk_ids"
      ],
      "title": "ReadArgs",
      "type": "object"
    }
  }
]